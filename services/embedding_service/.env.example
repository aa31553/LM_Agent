# Path to a fully downloaded Hugging Face / SentenceTransformers model directory.
EMBEDDING_MODEL_PATH=models/text-embedding-mxbai-embed-large-v1
EMBEDDING_MODEL_NAME=text-embedding-mxbai-embed-large-v1
EMBEDDING_DEVICE=auto
EMBEDDING_NORMALIZE=true
EMBEDDING_MAX_BATCH_SIZE=32
EMBEDDING_MAX_INPUT_CHARS=100000
EMBEDDING_SERVICE_API_KEY=
EMBEDDING_HOST=127.0.0.1
EMBEDDING_PORT=1234
