APP_NAME=LM Agent API
APP_VERSION=0.13.0
ENVIRONMENT=local
CORS_ALLOW_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Local PostgreSQL + pgvector development database
DATABASE_URL=postgresql+psycopg://lm_agent:lm_agent@localhost:5432/lm_agent
# Lightweight SQLite alternative (pgvector/pg_trgm features still require PostgreSQL):
# DATABASE_URL=sqlite:///data/lm_agent.sqlite3
ADMIN_DATABASE_URL=
# Optional in current local MVP flow
REDIS_URL=redis://localhost:6379/0
LOCAL_STORAGE_ROOT=data/uploads
SKILLS_ROOT=data/skills
SKILL_MAX_FILE_BYTES=10000000
TESSERACT_CMD=
EMBEDDING_ENDPOINT=http://127.0.0.1:1234/v1/embeddings
EMBEDDING_SERVICE_BASE_URL=http://127.0.0.1:1234
EMBEDDING_MODEL=text-embedding-mxbai-embed-large-v1
EMBEDDING_DIMENSION=1024
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=90
EMBEDDING_SSL_VERIFY=true
LLM_BASE_URL=http://127.0.0.1:1234
LLM_API_PATH=/v1/chat/completions
# Internal API: leave empty to omit the Authorization header.
LLM_API_KEY=
# Internal HTTPS with a private/self-signed certificate: false. Use true for public endpoints.
LLM_SSL_VERIFY=false
# Set this to the exact identifier exposed by the internal 31B model service.
LLM_MODEL=your-internal-31b-model-name
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_MAX_TOKENS=1536
# Full model context window. Prompt budget = context window - output - safety margin.
LLM_CONTEXT_WINDOW_TOKENS=32768
LLM_PROMPT_SAFETY_MARGIN_TOKENS=1024
# Leave empty for a non-reasoning model.
LLM_REASONING_EFFORT=
CHAT_REQUEST_TIMEOUT_SECONDS=180
CHAT_QUEUE_TIMEOUT_SECONDS=15
# Set this to the number of simultaneous requests the upstream LLM can safely accept.
CHAT_MAX_CONCURRENT_REQUESTS=4
CHAT_HISTORY_MAX_TURNS=6
CHAT_HISTORY_MAX_CHARS=8000
CODE_CONTEXT_MAX_TOKENS=12000
CODE_CONTEXT_MAX_CHARS=60000
AGENT_TOOL_PROMPT_RESERVE_TOKENS=4096
AGENT_TOOL_CONTEXT_MAX_CHARS=12000
CONTEXT_MAX_TOKENS=2500
CONTEXT_MAX_CHARS=10000

# The API never runs document jobs. Start this in another terminal/service:
# python -m app.workers.document_tasks
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_JOB_TIMEOUT_SECONDS=900
WORKER_RETRY_ATTEMPTS=2
# Office files are opened through Word/Excel/PowerPoint COM in a bounded child process.
OFFICE_COM_TIMEOUT_SECONDS=300
DOCUMENT_MAX_UPLOAD_BYTES=100000000
PDF_MAX_FILE_BYTES=50000000
PDF_MAX_PAGES=200
PDF_PAGE_TIMEOUT_SECONDS=20
PDF_JOB_TIMEOUT_SECONDS=600
# Full-page OCR runs only when pypdf finds no text. Embedded image extraction/OCR are opt-in.
PDF_OCR_ENABLED=true
PDF_IMAGE_EXTRACTION_ENABLED=false
PDF_IMAGE_MAX_PAGES=20
PDF_IMAGE_MAX_COUNT=50
PDF_IMAGE_OCR_ENABLED=false
PDF_IMAGE_OCR_MAX_COUNT=10

# Session analysis workspace. Start the dedicated worker with:
# python -m app.workers.analysis_tasks
ANALYSIS_UPLOAD_MAX_BYTES=500000000
ANALYSIS_MAX_ROWS=5000000
ANALYSIS_MAX_GROUPS=5000
ANALYSIS_RESULT_MAX_ROWS=5000
ANALYSIS_SAMPLE_ROWS=20
ANALYSIS_EXPLANATION_MAX_CHARS=12000
ANALYSIS_RETENTION_HOURS=168
ANALYSIS_JOB_TIMEOUT_SECONDS=1800
ANALYSIS_PROFILE_TIMEOUT_SECONDS=3600
ANALYSIS_PROFILE_SAMPLE_ROWS=50
ANALYSIS_PROFILE_MAX_COLUMNS=500
ANALYSIS_JOIN_MAX_SOURCES=8
ANALYSIS_ADVANCED_COLLECT_MAX_ROWS=500000
ANALYSIS_CHART_MAX_POINTS=5000
ANALYSIS_EXPORT_MAX_ROWS=100000
ANALYSIS_PLAN_SCHEMA_MAX_CHARS=16000
ANALYSIS_HYBRID_CONTEXT_MAX_CHARS=24000
